# Copy to backend/.env for local development. Generate secrets with:
#   python scripts/gen_keys.py
APP_ENV=development
SECRET_KEY=
# Application user: DML + EXECUTE only (see db/security/grants.sql)
DATABASE_URL=mysql+pymysql://homenest_app:change-me@127.0.0.1:3306/homenest?charset=utf8mb4
# Optional read replica used for search and analytics
DATABASE_REPLICA_URL=
# Migrations run with DDL rights
MIGRATION_DATABASE_URL=mysql+pymysql://homenest_migrator:change-me@127.0.0.1:3306/homenest?charset=utf8mb4
# TLS to MySQL: set DB_SSL_CA to the server CA, or DB_SSL_REQUIRED=true for encryption without verification
DB_SSL_CA=
DB_SSL_REQUIRED=false

# Envelope encryption keys (base64, 32 bytes). Rotate: add v2, set KEK_ACTIVE=v2, run scripts/rotate_keys.py
KEK_KEYS=v1:
KEK_ACTIVE=v1
BLIND_INDEX_KEY=

# mysqldump account for encrypted backups (SELECT, SHOW VIEW, TRIGGER, LOCK TABLES, EVENT)
BACKUP_DATABASE_URL=mysql://homenest_backup:change-me@127.0.0.1:3306/homenest
BACKUP_DIR=

REDIS_URL=
COOKIE_SECURE=false
REQUIRE_VERIFIED_EMAIL=true
FRONTEND_URL=http://localhost:3000
# Leave empty to print emails to the API log
SMTP_URL=
# Leave empty to use the simulated payment flow
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Leave empty to store uploads on local disk
S3_BUCKET=
S3_ENDPOINT_URL=
S3_PUBLIC_URL=
SENTRY_DSN=
