# Copy to .env and fill in. .env is git-ignored.
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_hex(32))"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=real_estate
DB_USER=real_estate_app
DB_PASSWORD=change-me-app
# Set to false only for local http:// development
SESSION_COOKIE_SECURE=true
FLASK_DEBUG=0
